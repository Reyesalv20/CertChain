# ─────────────────────────────────────────────────────────────
# Backend (NestJS) — variables de entorno
# Para desarrollo local (npm run start:dev): copia a .env (dotenv lo lee
# automáticamente desde /app/.env):
#   cp .env.example .env
# Para Docker: estas variables vienen del .env de la raíz.
#
# La SUPABASE_SERVICE_ROLE_KEY es SECRETA. Solo vive en el backend.
# ─────────────────────────────────────────────────────────────

PORT=4000

# CORS: orígenes permitidos (el frontend).
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (proyecto del equipo). Service role key = acceso total, SECRETA.
SUPABASE_URL=https://hfcasvdqrvjvuprxnpvc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Servicios internos (nombres dentro de la red Docker).
# Para desarrollo local sin Docker, apuntan a localhost.
LLM_SERVICE_URL=http://localhost:5000
BLOCKCHAIN_SERVICE_URL=http://localhost:6000
