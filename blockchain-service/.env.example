# ── Configuración local del server (flujo SIN Docker) ─────────────
# Copiá este archivo a .env:   cp .env.example .env

RPC_URL=http://127.0.0.1:8545

# Clave pública de desarrollo de la cuenta 1 de anvil (EMISOR) — firma certificados
PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Clave pública de desarrollo de la cuenta 0 de anvil (ADMIN/ente regulador) — agrega/elimina emisores
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Modo dev: habilita los endpoints /addIssuer y /removeIssuer firmados por el server.
# En producción se deja sin setear y el regulador firma client-side.
ENABLE_DEV_ADMIN=true

# Direcciones de los contratos desplegados (ver README paso 3 del flujo local)
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
TRUSTED_ISSUERS_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

PORT=6000
