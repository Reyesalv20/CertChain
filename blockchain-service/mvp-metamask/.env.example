# RPC de la blockchain (anvil) para las lecturas (view).
# Local por defecto. Para el modo compartido (túnel), apuntar a la URL pública.
VITE_RPC_URL=http://127.0.0.1:8545

# URL del /config del blockchain-service.
# "/config" usa el proxy de Vite (configurado en vite.config.js) — ideal local.
# Para túnel, usar la URL completa, ej: https://yyy.ngrok.io/config
VITE_CONFIG_URL=/config
