# Copia este archivo a .env y ajusta los valores si es necesario.
# docker-compose.yml ya trae valores por defecto que funcionan entre contenedores.

# --- frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://backend:4000
NEXT_PUBLIC_RPC_URL=http://localhost:8545

# --- Supabase (proyecto compartido del equipo) ---
# Públicas — las usa el frontend en el navegador (la publishable key es segura por diseño):
NEXT_PUBLIC_SUPABASE_URL=https://hfcasvdqrvjvuprxnpvc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend (NestJS) — la service role key es SECRETA, NUNCA va al frontend:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- backend ---
PORT=4000
LLM_SERVICE_URL=http://llm-service:5000
BLOCKCHAIN_SERVICE_URL=http://blockchain-service:6000

# --- blockchain-service ---
# PORT=6000
# RPC_URL=http://anvil:8545
# PRIVATE_KEY=0x...  (cuenta 1 de anvil — emisor legacy)
# ADMIN_PRIVATE_KEY=0x...  (cuenta 0 de anvil — ente regulador, solo dev)
# ENABLE_DEV_ADMIN=true  (habilita /addIssuer y /removeIssuer firmados por el server)
# (las direcciones de los contratos las escribe deploy en el volumen shared; no van acá)

# --- llm-service ---
# PORT=5000
# Contenedor local por defecto. Para usar Ollama corriendo en otra máquina
# (ej. túnel de Cloudflare/ngrok), descomenta y pon tu URL:
# OLLAMA_URL=https://tu-tunel.trycloudflare.com
OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL_LLAMA3=llama3
# OLLAMA_MODEL_MISTRAL=mistral
# MOCK_CERTIFICADOS=true  (backend aún no expone GET /certificados/por-rfid/:uid)
