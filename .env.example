# ─────────────────────────────────────────────────────────────
# CertChain — variables de entorno (raíz)
# Copia a .env:   cp .env.example .env
# docker-compose.yml (raíz) lee estos valores con ${VAR}.
# Para desarrollo SIN Docker (npm run dev), cada servicio lee
# su propio .env.local / .env (ver cada carpeta).
# ─────────────────────────────────────────────────────────────

# ── Supabase (proyecto compartido del equipo) ────────────────
# Públicas — van al navegador (la publishable key es segura por diseño):
NEXT_PUBLIC_SUPABASE_URL=https://hfcasvdqrvjvuprxnpvc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mZgwDEsn4yOvpfemMqxP5w_6FcNujy_

# Backend (NestJS) — la service role key es SECRETA, NUNCA va al frontend:
SUPABASE_URL=https://hfcasvdqrvjvuprxnpvc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Frontend (Next.js) ───────────────────────────────────────
# URLs que usa el NAVEGADOR -> localhost (puertos expuestos al host):
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BLOCKCHAIN_SERVICE_URL=http://localhost:6000
# URLs server-side (SSR) -> nombre del servicio dentro de Docker:
BACKEND_INTERNAL_URL=http://backend:4000

# ── Backend (NestJS) ─────────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Nombres de servicios DENTRO de la red Docker:
LLM_SERVICE_URL=http://llm-service:5000
BLOCKCHAIN_SERVICE_URL=http://blockchain-server:6000

# ── llm-service (FastAPI) ────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL_LLAMA3=llama3
OLLAMA_MODEL_MISTRAL=mistral
MOCK_CERTIFICADOS=true

# ── blockchain-service ───────────────────────────────────────
# Los siguientes usan claves de desarrollo de anvil (SOLO pruebas).
# Las direcciones de los contratos las escribe el deploy en /shared, no van acá.
# RPC_URL=http://anvil:8545
# PORT=6000
# ENABLE_DEV_ADMIN=true
