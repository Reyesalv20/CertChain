# Copia este archivo a .env y ajusta los valores si es necesario.
# docker-compose.yml ya trae valores por defecto que funcionan entre contenedores.

# --- frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://backend:4000

# --- backend ---
PORT=4000
LLM_SERVICE_URL=http://llm-service:5000
BLOCKCHAIN_SERVICE_URL=http://blockchain-service:6000

# --- blockchain-service ---
# PORT=6000
# (agregar aquí variables de red blockchain cuando se implemente: RPC_URL, PRIVATE_KEY, CONTRACT_ADDRESS, etc.)

# --- llm-service ---
# PORT=5000
OLLAMA_URL=http://ollama:11434
