# ─────────────────────────────────────────────────────────────
# Frontend (Next.js) — variables de entorno
# Para desarrollo local (npm run dev): copia a .env.local
#   cp .env.example .env.local
# Para Docker: estas variables vienen del .env de la raíz
#   (docker-compose hace la interpolación ${VAR}).
#
# SOLO las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# NUNCA pongas acá la service role key de Supabase (es secreta).
# ─────────────────────────────────────────────────────────────

# URL del backend (NestJS). La usa el NAVEGADOR -> localhost.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# URL del blockchain-service. La usa next.config.js en el rewrite
# (/blockchain/* -> blockchain-service). Desde el navegador es localhost.
NEXT_PUBLIC_BLOCKCHAIN_SERVICE_URL=http://localhost:6000

# URL del backend para código server-side (SSR / route handlers) dentro de Docker.
BACKEND_INTERNAL_URL=http://backend:4000

# Supabase (proyecto del equipo). La publishable key es pública (segura para el browser).
NEXT_PUBLIC_SUPABASE_URL=https://hfcasvdqrvjvuprxnpvc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mZgwDEsn4yOvpfemMqxP5w_6FcNujy_
