# Plantilla para el frontend (Next.js).
# Copiar a .env.local:   cp .env.local.example .env.local
#
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# Las de Supabase de abajo son PÚBLICAS (la "publishable key" es segura
# para el browser por diseño). NUNCA pongas acá la "service role key".

# URL del backend (NestJS), la usa el navegador.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# URL del blockchain-service. Se usa en el rewrite de next.config.js
# (/blockchain/* -> blockchain-service). Desde el navegador es localhost.
NEXT_PUBLIC_BLOCKCHAIN_SERVICE_URL=http://localhost:6000

# Supabase (proyecto compartido del equipo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
